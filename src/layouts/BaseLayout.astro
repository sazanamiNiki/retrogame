---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import Schema from '../components/Schema.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'iPhoneでレトロゲームを合法的に楽しむ方法を日本語で解説。Deltaエミュレータの導入、GB Operatorによるカートリッジからの合法ROM吸い出し、著作権法第30条の解説まで。',
  ogType = 'website',
  ogImage = '/assets/img/logo.png',
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://retrogame.bunchoniki.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const base = import.meta.env.BASE_URL;

// WebSiteスキーマ: サイト全体の構造化データ（全ページ共通）
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "bunchoniki Retro",
  "url": siteUrl,
  "description": "iPhoneでレトロゲームを合法的に楽しむ方法を日本語で解説。Deltaエミュレータ・GB Operator・著作権法第30条の統合ガイド。",
  "inLanguage": "ja",
  "publisher": {
    "@type": "Organization",
    "name": "bunchoniki Retro",
    "url": siteUrl,
    "logo": `${siteUrl}/assets/img/logo.png`
  }
};

// Organizationスキーマ: 運営組織情報（全ページ共通）
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "bunchoniki Retro",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/img/logo.png`,
  "founder": {
    "@type": "Person",
    "name": "bunchoniki",
    "url": "https://altstore-jp.bunchoniki.com/articles/our-policy/",
    "description": "2019年からAltStore等のサイドローディングツールを利用し、レトロゲームを合法的に楽しんできたiOSユーザー。日本語圏の情報格差を埋める活動。"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "contact@bunchoniki.com",
    "contactType": "customer support",
    "availableLanguage": ["Japanese"]
  }
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>{title} | bunchoniki Retro</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noIndex && <meta name="robots" content="noindex" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={`${title} | bunchoniki Retro`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${siteUrl}${base.slice(0, -1)}${ogImage}`} />
  <meta property="og:site_name" content="bunchoniki Retro" />
  <meta property="og:locale" content="ja_JP" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | bunchoniki Retro`} />
  <meta name="twitter:description" content={description} />

  <!-- Favicon -->
  <link rel="icon" href={`${base}assets/img/logo.png`} />

  <!-- Material Symbols Outlined -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3579213602196152" crossorigin="anonymous" is:inline></script>

  <!-- 構造化データ（JSON-LD）: WebSite / Organization -->
  <Schema data={websiteSchema} />
  <Schema data={organizationSchema} />

  <!-- 記事ページなど各レイアウトが追加スキーマを注入する場所 -->
  <slot name="schema" />
</head>
<body class="bg-gray-50 text-gray-900">
  <StatusBar />
  <Header />
  <slot />
  <Footer />

  <!-- Accessibility: 装飾的なMaterial Symbolsアイコンに aria-hidden を一括付与 -->
  <script is:inline>
    document.querySelectorAll('.material-symbols-outlined:not([aria-label]):not([aria-hidden])').forEach(function(el) {
      el.setAttribute('aria-hidden', 'true');
    });
  </script>

  <!-- Accessibility: prefers-reduced-motion 時に自動再生動画を一時停止 -->
  <script is:inline>
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('video[autoplay]').forEach(function(v) { v.pause(); });
    }
  </script>
</body>
</html>
